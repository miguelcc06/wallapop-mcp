# Coordenadas por defecto (Madrid). El agente puede sobreescribirlas por tool.
WALLAPOP_LATITUDE=40.416775
WALLAPOP_LONGITUDE=-3.703790

# Perfil público propio. Sin este valor, wp_my_items y wp_my_item_advice explican cómo configurarlo.
WALLAPOP_USER_ID=

# Proxy HTTP(S) opcional para salir por una IP residencial si CloudFront devuelve 403.
# Ejemplo: http://user:pass@host:port
WALLAPOP_PROXY=

# Ritmo prudente. No bajar de 500 ms entre peticiones.
WALLAPOP_RATE_LIMIT_RPS=1
WALLAPOP_MIN_DELAY_MS=500
WALLAPOP_JITTER_MS=250
WALLAPOP_MAX_RETRIES=3
WALLAPOP_TIMEOUT_S=20

# SQLite local (snapshots, watchlist, caché). Relativo al cwd o absoluto.
WALLAPOP_DB_PATH=data/wallapop_intel.sqlite
WALLAPOP_SNAPSHOT_TTL_DAYS=90

# Firma X-Signature heredada. Verificado el 2026-09-24: NO es necesaria para búsqueda ni ficha.
# Déjala en 0. Activarla puede provocar 400.
WALLAPOP_SIGN_REQUESTS=0

# Enriquecimiento HTML opcional (__NEXT_DATA__). La ficha JSON ya trae views/favorites.
# Déjalo en 0 salvo que counters venga vacío.
WALLAPOP_ENRICH_HTML=0

# Transporte: stdio (por defecto) o http (streamable HTTP en 127.0.0.1).
WALLAPOP_TRANSPORT=stdio
WALLAPOP_HTTP_HOST=127.0.0.1
WALLAPOP_HTTP_PORT=8000

WALLAPOP_LANGUAGE=es-ES
